# ============================================================
# Intramed Web Automation - Variables de entorno
# ------------------------------------------------------------
# Copiar este archivo a `.env` y completar los valores reales.
# NUNCA commitear el `.env` (ya está en .gitignore).
# ============================================================

# --- Intramed Credentials ---
# Usuario principal que corre los tests E2E
TEST_EMAIL=tu-email@conexa.ai
TEST_PASSWORD=tu_password
# Credenciales inválidas para los tests de login negativo (no hace falta que existan)
TEST_INVALID_EMAIL=usuario.inexistente@intramed-test.com
TEST_INVALID_PASSWORD=cualquierClave123

# --- Segundo usuario para tests de chat (CHT-005, CHT-006) ---
# Necesario para los flujos donde se envían mensajes entre dos cuentas
CHAT_USER2_EMAIL=chatautomation@yopmail.com
CHAT_USER2_PASSWORD=tu_password

# --- Intramed URLs (QA) ---
BASE_URL=https://intramed-front-qa.conexa.ai
LOGIN_URL=https://intramed-login-qa.conexa.ai/login

# --- Gmail API (OTP para onboarding) ---
# Se usa en tests/specs/E2E/E2E_06_Onboarding.spec.ts para leer el código de verificación
# que Intramed manda al mail durante el signup.
#
# Pasos para obtener el refresh token (una vez por proyecto):
#   1. Completar GMAIL_CLIENT_ID y GMAIL_CLIENT_SECRET (los da el owner del proyecto en GCP).
#   2. node utils/gmail-auth-url.js  -> imprime una URL de autorización.
#   3. Abrir la URL, loguearse con GMAIL_TEST_INBOX y aceptar el permiso de lectura.
#   4. Copiar el "code" de la URL de redirección (expira en ~1 min).
#   5. node utils/gmail-get-refresh-token.js "<code>"  -> imprime el refresh token.
GMAIL_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu_client_secret
GMAIL_REFRESH_TOKEN=tu_refresh_token
GMAIL_TEST_INBOX=automationintramed@gmail.com

# --- Zephyr Scale (reporte de resultados) ---
# Token JWT de Zephyr Scale (Jira -> Zephyr -> API Access Tokens). Dura ~1 año.
ZEPHYR_AUTH_TOKEN=tu_zephyr_jwt_token
# Project key en Jira (ej: IE)
ZEPHYR_PROJECT_KEY=IE
# Folder ID donde se crean los ciclos de ejecución (verlo en la URL de la carpeta en Zephyr)
ZEPHYR_FOLDER_ID=46522899
