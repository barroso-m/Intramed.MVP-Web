{
  "name": "intramed-web-automation",
  "version": "1.0.0",
  "description": "Automatización web con Playwright para Intramed",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed --project=Chromium",
    "test:ui": "playwright test --ui",
    "test:ui:chrome": "playwright test --ui --project=Chromium",
    "test:chrome": "playwright test --project=Chromium",
    "test:login": "playwright test tests/specs/E2E/E2E_01_Login.spec.ts --project=Chromium",
    "test:feed": "playwright test tests/specs/E2E/E2E_02_Feed.spec.ts --project=Chromium",
    "test:profile": "playwright test tests/specs/E2E/E2E_03_Profile.spec.ts --project=Chromium",
    "test:onboarding": "playwright test tests/specs/E2E/E2E_06_Onboarding.spec.ts --project=Chromium",
    "test:report": "playwright show-report",
    "zephyr:report": "node utils/zephyr-report.js",
    "test:zephyr": "npm run test && npm run zephyr:report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "playwright test && npm run allure:report"
  },
  "keywords": [
    "Automation Web",
    "Intramed",
    "Conexa"
  ],
  "author": "Martin Barroso",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.58.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "@types/xml2js": "^0.4.14",
    "allure-commandline": "^2.40.0",
    "allure-playwright": "^3.7.2",
    "dotenv": "^16.6.1",
    "playwright-zephyr": "^1.2.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "form-data": "^4.0.5",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.3",
    "xml2js": "^0.6.2"
  }
}